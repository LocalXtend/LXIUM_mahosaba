<?xml version="1.0" encoding="utf-8"?>
<!-- 관리 힙 할당 샘플: .NET 런타임(BepInEx의 CoreCLR)의 GCAllocationTick(약 100 KB마다 할당한 형식 이름)과 GC 이벤트만
     사용: wpr -start tools\Prof\alloc.wprp!Alloc -filemode  ...  wpr -stop out.etl → Prof alloc out.etl -->
<WindowsPerformanceRecorder Version="1.0">
  <Profiles>
    <EventCollector Id="EC" Name="LXIUM Alloc">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
    </EventCollector>
    <!-- Microsoft-Windows-DotNETRuntime, GC 키워드(0x1), 자세히(5) -->
    <EventProvider Id="CLR" Name="e13c0d23-ccbc-4e12-931b-d9cc2eee27e4" Level="5">
      <Keywords>
        <Keyword Value="0x1"/>
      </Keywords>
    </EventProvider>
    <Profile Id="Alloc.Verbose.File" Name="Alloc" Description="LXIUM managed allocation ticks" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <EventCollectorId Value="EC">
          <EventProviders>
            <EventProviderId Value="CLR"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
